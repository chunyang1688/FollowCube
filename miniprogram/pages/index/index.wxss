.home {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hello {
  padding: 28rpx 12rpx 36rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.menu {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
}

.menu-body {
  flex: 1;
}

.menu-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  text-align: center;
  line-height: 96rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.mark-fill {
  background: #ff8a5b;
}

.mark-cam {
  background: #6aa6ff;
}

.mark-practice {
  background: #f0a202;
}

.mark-go {
  background: #3cb389;
}
