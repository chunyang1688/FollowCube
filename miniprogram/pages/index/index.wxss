.page {
  padding-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.solver-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c9cdd4;
}

.dot-ok {
  background: var(--fc-primary);
}

/* 色板 */
.palette {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.palette-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 92rpx;
  padding: 10rpx 0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.palette-active {
  border-color: var(--fc-primary);
  background: #f0faf4;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
}

.palette-label {
  font-size: 22rpx;
  color: var(--fc-muted);
}

/* 4 列 × 3 行展开图 */
.net {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(3, auto);
  gap: 12rpx 8rpx;
  margin: 8rpx 0 20rpx;
}

.face {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.face-title {
  font-size: 20rpx;
  color: var(--fc-muted);
  white-space: nowrap;
}

.face-grid {
  display: grid;
  grid-template-columns: repeat(3, 48rpx);
  grid-template-rows: repeat(3, 48rpx);
  gap: 4rpx;
  padding: 6rpx;
  background: #2b2b2b;
  border-radius: 8rpx;
}

.cell {
  width: 48rpx;
  height: 48rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
}

.cell.is-center {
  box-shadow: inset 0 0 0 3rpx rgba(0, 0, 0, 0.28);
}

.cell.is-error {
  box-shadow: inset 0 0 0 4rpx var(--fc-danger);
}

.counts {
  display: block;
  font-size: 24rpx;
  color: var(--fc-muted);
  line-height: 1.6;
}

.hint {
  display: block;
  margin-top: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #315efb;
  background: #f2f6ff;
  border-radius: 10rpx;
}

.hint-error {
  color: var(--fc-danger);
  background: #fff2f2;
}

/* 解法 */
.formula {
  display: block;
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
  background: #f7f8fa;
  border-radius: 10rpx;
}

.go-follow,
.go-camera {
  margin-top: 20rpx;
}

.step-list {
  margin-top: 20rpx;
  max-height: 420rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--fc-border);
}

.step-no {
  width: 48rpx;
  font-size: 24rpx;
  color: var(--fc-muted);
}

.step-token {
  width: 90rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.step-desc {
  flex: 1;
  font-size: 26rpx;
}
