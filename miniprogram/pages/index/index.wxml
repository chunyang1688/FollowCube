<view class="home">
  <view class="hello">
    <view class="title">跟着还原魔方</view>
    <text class="muted">填颜色、拍照，或先练一练，再一步步跟着转。</text>
  </view>

  <view class="menu" bindtap="onPaint">
    <view class="mark mark-fill">填</view>
    <view class="menu-body">
      <view class="menu-title">我来填色</view>
      <text class="muted">转动魔方，点贴纸填上颜色</text>
    </view>
  </view>

  <view class="menu" bindtap="onCamera">
    <view class="mark mark-cam">拍</view>
    <view class="menu-body">
      <view class="menu-title">拍照识别</view>
      <text class="muted">按中心色拍六个面，自动填进魔方</text>
    </view>
  </view>

  <view class="menu" bindtap="onPractice">
    <view class="mark mark-practice">练</view>
    <view class="menu-body">
      <view class="menu-title">练一练</view>
      <text class="muted">从还原好的魔方开始，自己转，或看它怎么还原</text>
    </view>
  </view>

  <view class="menu" bindtap="onFollow">
    <view class="mark mark-go">转</view>
    <view class="menu-body">
      <view class="menu-title">跟着转</view>
      <text class="muted">{{followTip}}</text>
    </view>
  </view>
</view>
