/* 全局样式：暖米色纸底 + 珊瑚橙主按钮。魔方六色保持真色，背景不再抢颜色。 */
page {
  --fc-bg: #fff6ea;
  --fc-card: #ffffff;
  --fc-text: #2f343a;
  --fc-muted: #7b8494;
  --fc-primary: #ff8a5b;
  --fc-primary-soft: #fff1e6;
  --fc-danger: #e85d4c;
  --fc-border: #f0e4d4;
  --fc-slot: #e4ddd4;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  color: var(--fc-text);
  background-color: var(--fc-bg);
  box-sizing: border-box;
}

view,
text,
button {
  box-sizing: border-box;
}

.card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: var(--fc-card);
  border-radius: 16rpx;
}

.muted {
  color: var(--fc-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.btn {
  margin: 0;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: var(--fc-primary-soft);
  color: var(--fc-text);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--fc-primary);
  color: #ffffff;
}

.btn[disabled] {
  opacity: 0.45;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
