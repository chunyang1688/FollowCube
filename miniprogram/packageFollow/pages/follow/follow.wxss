.page {
  padding-bottom: 40rpx;
}

.progress {
  height: 12rpx;
  background: #ebedf0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-bar {
  height: 100%;
  background: var(--fc-primary);
  transition: width 0.2s ease;
}

.view-card {
  padding: 16rpx;
}

.cube-canvas {
  width: 100%;
  height: 520rpx;
  display: block;
  background: var(--fc-bg);
  border-radius: 12rpx;
}

.view-fallback {
  width: 100%;
  height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: var(--fc-bg);
  border-radius: 12rpx;
  text-align: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.fallback-icon {
  font-size: 72rpx;
  color: #c8c9cc;
}

.view-tools {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mini-btn {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #333;
  background: var(--fc-primary-soft);
  border-radius: 8rpx;
}

.mini-btn::after {
  border: none;
}

.step-card {
  text-align: center;
  padding: 44rpx 24rpx;
}

.step-label {
  font-size: 24rpx;
  color: var(--fc-muted);
}

.big-token {
  margin: 20rpx 0 12rpx;
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.1;
}

.big-desc {
  font-size: 34rpx;
  margin-bottom: 20rpx;
}

.success {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--fc-primary);
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.formula {
  display: block;
  padding: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
  background: var(--fc-bg);
  border-radius: 10rpx;
}

.auto-btn {
  margin-top: 16rpx;
}

.step-list {
  margin-top: 20rpx;
  max-height: 480rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 12rpx;
  border-bottom: 1rpx solid var(--fc-border);
  border-radius: 8rpx;
}

.step-done {
  opacity: 0.45;
}

.step-current {
  background: var(--fc-primary-soft);
}

.step-no {
  width: 48rpx;
  font-size: 24rpx;
  color: var(--fc-muted);
}

.step-token {
  width: 90rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.step-desc {
  flex: 1;
  font-size: 26rpx;
  text-align: left;
}

.back {
  margin-top: 24rpx;
}
