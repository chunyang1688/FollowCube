.page {
  min-height: 100vh;
  padding: 12rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.hint {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--fc-text);
}

.hint-error {
  color: var(--fc-danger);
}

.seeing {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fc-muted);
}

.stage {
  margin: 12rpx 0 8rpx;
}

.cube,
.fallback {
  width: 100%;
  height: 680rpx;
  display: block;
  background: var(--fc-bg);
  border-radius: 24rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.palette {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin: 8rpx 0 28rpx;
}

.chip {
  width: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
}

.chip.on {
  border-color: var(--fc-primary);
  background: var(--fc-primary-soft);
}

.swatch,
.cam {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.cam {
  background: #fff;
  color: var(--fc-primary);
  font-size: 26rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 600;
}

.chip-name {
  font-size: 22rpx;
  color: var(--fc-text);
}

.actions {
  display: flex;
  gap: 16rpx;
}

.grow {
  flex: 1;
}

.minor {
  margin-top: 24rpx;
  text-align: center;
  color: var(--fc-muted);
  font-size: 26rpx;
}

.sep {
  margin: 0 16rpx;
}
