.page {
  min-height: 100vh;
  padding: 12rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.hint,
.step-line {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--fc-text);
}

.step-line {
  margin: 8rpx 0 16rpx;
  color: var(--fc-muted);
  font-size: 26rpx;
}

.stage {
  margin: 12rpx 0 20rpx;
}

.cube,
.fallback {
  width: 100%;
  height: 640rpx;
  display: block;
  background: var(--fc-bg);
  border-radius: 24rpx;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.second {
  margin-top: 16rpx;
}

.grow {
  flex: 1;
}

.speed-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.speed-label {
  font-size: 24rpx;
  color: var(--fc-muted);
}

.speed {
  min-width: 112rpx;
  padding: 12rpx 20rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: var(--fc-text);
  font-size: 26rpx;
}

.speed.on {
  background: var(--fc-primary);
  color: #fff;
}
